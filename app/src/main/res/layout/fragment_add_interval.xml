<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".AddIntervalFragment">

    <LinearLayout
        android:id="@+id/AddIntervalLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/backButtonCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                style="@style/NoClickEffect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/white"
                android:padding="8dp"
                android:src="@drawable/chevron_left"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>

        <TextView
            android:id="@+id/addTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/pretendardbold"
            android:gravity="center"
            android:maxLines="1"
            android:text="수면 기록 추가"
            android:textColor="@color/black"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/addLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/addSmallTitle"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="top"
                android:layout_marginBottom="4dp"
                android:autoSizeMaxTextSize="16sp"
                android:autoSizeMinTextSize="12sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/pretendardbold"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="추가할 수면 정보"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/addSmallText"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="16dp"
                android:autoSizeMaxTextSize="12sp"
                android:autoSizeMinTextSize="6sp"
                android:autoSizeStepGranularity="2sp"
                android:autoSizeTextType="uniform"
                android:fontFamily="@font/pretendardvariable"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="추가할 수면의 시작 및 종료 시각을 입력해주세요"
                android:textColor="@color/gray_4"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/timeSettingView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/startText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:autoSizeMaxTextSize="16sp"
                    android:autoSizeMinTextSize="10sp"
                    android:autoSizeStepGranularity="2sp"
                    android:autoSizeTextType="uniform"
                    android:fontFamily="@font/pretendardvariable"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:text="수면 시작 날짜"
                    android:textColor="@color/black"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/startTimeSettingView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="right"
                    android:orientation="vertical"
                    android:weightSum="10">

                    <Button
                        android:id="@+id/startDateButton"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_gravity="right"
                        android:layout_marginHorizontal="8dp"
                        android:autoSizeMaxTextSize="14sp"
                        android:autoSizeMinTextSize="6sp"
                        android:autoSizeStepGranularity="2sp"
                        android:autoSizeTextType="uniform"
                        android:backgroundTint="@color/gray_1"
                        android:fontFamily="@font/pretendardvariable"
                        android:maxLines="1"
                        android:text="Oct 24, 2023"
                        android:textColor="@color/black"
                        android:textSize="14sp" />

                </LinearLayout>
            </LinearLayout>

            <!-- TimeRangePicker -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <nl.joery.timerangepicker.TimeRangePicker
                    android:id="@+id/SleepTimePicker"
                    android:layout_width="300dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal|center_vertical"
                    app:trp_thumbIconSize="28dp"
                    app:trp_thumbIconStart="@drawable/circle_start_thumb"
                    app:trp_thumbIconEnd="@drawable/circle_end_thumb"
                    app:trp_clockLabelSize="0sp"
                    app:trp_maxDurationMinutes="1440"
                    app:trp_hourFormat="FORMAT_24"
                    app:trp_sliderWidth="8dp"
                    app:trp_sliderColor="@color/blue_2"
                    app:trp_startTime="00:00"
                    app:trp_thumbColor="@color/white"
                    app:trp_sliderRangeColor="@color/white"/>

                <LinearLayout
                    android:id="@+id/SleepNoticeCaption"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal|center_vertical"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/sleepRangeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/pretendardbold"
                        android:text="00:00 → 00:00"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/sleepGuidance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:fontFamily="@font/pretendardvariable"
                        android:text="(드래그하여 시작/끝을 조절)"
                        android:textColor="@color/gray_4"
                        android:textSize="12sp" />
                </LinearLayout>
            </FrameLayout>

        </LinearLayout>

        <Button
            android:id="@+id/addButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:autoSizeMaxTextSize="16sp"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeStepGranularity="2sp"
            android:autoSizeTextType="uniform"
            android:backgroundTint="@color/blue_1"
            android:fontFamily="@font/pretendardvariable"
            android:maxLines="1"
            android:padding="16dp"
            android:text="추가하기"
            android:textSize="16sp"
            app:cornerRadius="28dp" />

    </LinearLayout>
    <View
        android:id="@+id/dimBackgroundAddIntv"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dim"
        android:visibility="gone" />
</FrameLayout>